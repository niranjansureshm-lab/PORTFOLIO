# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=portfolio_db

# ---- Auth ----
# Change this to a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- First admin account (created by npm run db:setup) ----
ADMIN_NAME=Niranjan Suresh
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=Admin@12345

# ---- Hosted database (Neon / Render / Railway) ----
# If you set DATABASE_URL, the DB_* values above are ignored and SSL is enabled automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
